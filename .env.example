DEMO_TOOL_SECRET=
# Script models in fallback order, comma separated provider:model entries. Empty uses the default chain.
# gemini, groq, openrouter and anthropic are built in. Any other name also needs NAME_BASE_URL and NAME_API_KEY.
# Entries without a key are skipped. Restart after editing.
SCRIPT_MODELS=
GEMINI_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
# Voiceover voice. Empty uses Jessica (cgSgspJ2msm6clMCkdW9), a premade voice.
ELEVENLABS_VOICE_ID=
# Base of audioUrl and videoUrl. Empty uses http://localhost:PORT, for local runs.
# On Render set PUBLIC_BASE_URL=https://ycxelevenlabs.onrender.com
PUBLIC_BASE_URL=
POSTING_API_KEY=
PORT=
