# Copy to .env.local. Never commit real values.

# Public ElevenLabs agent id (from Artin). Not a secret key.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Display name of the company the coworker works for.
NEXT_PUBLIC_COMPANY_NAME=Kiln

# true = in-browser mock backend built from ../mocks (works with no backend running).
# false = real backend through the /api rewrite (GETs only; the agent does the POSTs).
NEXT_PUBLIC_USE_MOCK=true

# Where Next proxies /api/* to (server-side only). Deployed backend: https://ycxelevenlabs.onrender.com
# Local backend dev server runs on 3000; this app on 3001.
BACKEND_URL=http://localhost:3000
